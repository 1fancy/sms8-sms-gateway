{
  "name": "cordova-plugin-sms-otp-send",
  "version": "1.0.0",
  "description": "Cordova plugin to send SMS and send/verify OTP codes from iOS and Android — a free Twilio Verify alternative. Routes through your own paired Android phone via SMS8. Native iOS Swift + Android Kotlin bridges. No per-OTP fees, no markups. Free 5-day trial at sms8.io.",
