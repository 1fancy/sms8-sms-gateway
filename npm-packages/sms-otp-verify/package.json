{
  "name": "sms-otp-verify",
  "version": "1.0.0",
  "description": "SMS OTP verify for React — Twilio Verify alternative. Send, verify, and auto-fill SMS OTP codes with a ready-to-use <OtpInput /> UI (separators, RTL, mask, render props, error states), <OtpForm /> drop-in, useSms8Otp() hook, and a server-side Sms8Otp class. No Twilio, no per-OTP fees, no markups. Free 5-day trial at sms8.io.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react"
  },
  "keywords": [
    "sms-otp-verify",
    "sms-otp",
    "sms-verify",
    "otp-verify",
    "verify-otp",
    "send-otp",
    "verify-sms",
    "phone-verify",
    "phone-verification",
    "react-sms-otp",
    "react-otp-verify",
    "react-otp-input",
    "react-otp",
    "react-2fa",
    "react-2fa-input",
    "otp-input",
    "otp-input-react",
    "otp-input-ui",
    "otp-component",
    "otp-ui",
    "use-otp",
    "useotp",
    "use-sms-otp",
    "2fa",
    "two-factor",
    "two-factor-authentication",
    "twilio-alternative",
    "twilio-verify-alternative",
    "vonage-verify-alternative",
    "messagebird-verify-alternative",
    "sms-without-twilio",
    "android-sms-gateway",
    "sms8"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1fancy/sms8-sms-gateway.git",
    "directory": "npm-packages/sms-otp-verify"
  },
  "bugs": {
    "url": "https://github.com/1fancy/sms8-sms-gateway/issues"
  },
  "homepage": "https://sms8.io/sms-otp-verification-api-android",
  "author": "SMS8.io",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
